UID={{ lldap_user_uid }}
GID={{ lldap_user_gid }}
TZ={{ lldap_timezone }}

LLDAP_LDAP_BASE_DN={{ lldap_base_dn }}
LLDAP_LDAP_USER_PASS={{ lldap_admin_password }}
LLDAP_JWT_SECRET={{ lldap_jwt_secret }}
LLDAP_KEY_SEED={{ lldap_key_seed }}

LLDAP_LDAPS_OPTIONS__ENABLED: "true"
LLDAP_LDAPS_OPTIONS__CERT_FILE: /certs/fullchain.pem
LLDAP_LDAPS_OPTIONS__KEY_FILE: /certs/privkey.pem

LLDAP_URL: "http://{{ lldap_http_bind }}:17170"
LLDAP_ADMIN_USERNAME: admin
LLDAP_ADMIN_PASSWORD: ${LLDAP_LDAP_USER_PASS}
DO_CLEANUP: "false"
