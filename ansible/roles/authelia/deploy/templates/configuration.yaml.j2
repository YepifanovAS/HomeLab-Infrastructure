server:
  address: tcp://0.0.0.0:9091

log:
  level: info

authentication_backend:
  password_reset:
    disable: true
  password_change:
    disable: true

  ldap:
    implementation: lldap
    address: ldap://lldap:3890
    base_dn: "{{ lldap_base_dn }}"
    user: "uid={{ authelia_svc_user }},ou=people,{{ lldap_base_dn }}"

access_control:
  default_policy: one_factor
  rules: []
    # - domain: protected.example.com
    #   policy: two_factor

session:
  cookies:
    - domain: "{{ homelab_domain }}"
      authelia_url: "https://{{ authelia_fqdn }}"
      # default_redirection_url: https://protected.example.com

  redis:
    host: redis
    port: 6379

storage:
  local:
    path: /data/db.sqlite3

totp:
  disable: false
  issuer: "{{ homelab_domain }}"
  algorithm: sha1
  digits: 6
  period: 30

webauthn:
  disable: true

notifier:
  disable_startup_check: false

  smtp:
    address: "smtp://{{POSTFIX_HOSTNAME}}:25"
    timeout: 10s

    sender: "Authelia <auth-noreply@{{ homelab_domain }}>"
    identifier: "{{authelia_fqdn}}"
    subject: "[Authelia] {title}"

    startup_check_address: "admin@{{ homelab_domain }}"

    disable_require_tls: false
    disable_starttls: false
    disable_html_emails: false

    tls:
      server_name: "{{POSTFIX_HOSTNAME}}"
      skip_verify: false
      minimum_version: TLS1.2

identity_providers:
  oidc:
    hmac_secret: "{{authelia_oidc_hmac_secret}}"

    jwks:
      - key_id: 'oidc-rs256'
        algorithm: 'RS256'
        use: 'sig'
        key: |
{{ vault_authelia_oidc_jwks_key | trim | indent(10, true) }}

    clients:
{{ authelia_oidc_clients  | sort(attribute='client_id')  | to_nice_yaml(indent=2, sort_keys=true)  | indent(6, true) }}
