# Приклад конфігурації для модуля terragrunt/modules/proxmox_vms.
# Для використання скопіюйте у vm_config.yaml та задайте свої мережеві
# параметри, вільні VMID, наявний пул і публічні SSH-ключі.
#
# Структура:
#   single       — словник окремих ВМ із власними іменами;
#   multiples    — словник груп ВМ зі спільними параметрами;
#   import_disks — список образів для імпорту системних дисків.
# Усі три розділи потрібні. Для невикористаних розділів задайте
# single: {}, multiples: {} або import_disks: [] відповідно.
#
# Модуль створює ВМ із cloud-init; встановлення ОС із ISO не передбачено.
# Хост і сховища визначає proxmox_ve.yaml. Наразі всі ВМ та образи
# розміщуються на першому хості зі списку proxmox_ve_hosts.
# Типи ВМ визначає instance_types.yaml; RAM у ньому задана в MiB,
# розміри дисків у цьому файлі та size_minimum — у GiB.
#
# Імена ВМ, VMID та IP мають бути вільними у відповідному середовищі.
# Ключі single і згенеровані імена multiples утворюють спільний словник.
# При збігу ключів запис single повністю замінює запис multiples.

single:
  # Стабільний ключ ресурсу Terraform/OpenTofu. Рекомендовано збіг із name.
  # Зміна ключа змінює адресу ресурсу в стані Terraform/OpenTofu.
  app-01:
    # Ім'я ВМ у Proxmox і hostname, який має застосувати cloud-init.
    name: app-01
    vm:
      # Числовий ідентифікатор ВМ, унікальний у кластері Proxmox.
      vmid: 2100
      # Формат: <родина>.<тип>. midi.c2m6 задає 2 CPU та 6144 MiB RAM.
      # Образ і мінімальний диск беруться з vm.midi.default у каталозі типів.
      instance_type: midi.c2m6
      # Системний диск scsi0: модуль обирає більше з disk_size і size_minimum.
      disk_size: 40
      # Додаткові диски за порядком списку: scsi1, scsi2, ...
      # Якщо не потрібні, залиште additional_disks: []; ключ не видаляйте.
      additional_disks: []
      # Наявний пул Proxmox. Якщо ключ відсутній, використовується unidentified.
      # Порожній рядок і null не замінюються автоматично; пул не створюється.
      pool: infrastructure
      # Віртуальні мережеві адаптери: ключ — логічний індекс, значення — bridge.
      # Ті самі ключі мають бути в networks. Обидва словники обходяться
      # лексикографічно: net0, net1, net10, net2, ...
      interfaces:
        net0: vmbr0
      # Теги Proxmox. Модуль обов'язково додає тег terraform.
      # Якщо власні теги не потрібні, задайте tags: [].
      tags:
        - debian
        - debian-trixie
        - application
    # IP-параметри гостьової ОС для адаптерів із vm.interfaces.
    networks:
      net0:
        # Статична IPv4-адреса з довжиною префікса CIDR.
        ip: "192.168.0.201/24"
        # IPv4-шлюз. Для мережі без шлюзу приберіть ключ або задайте null.
        # Не використовуйте порожній рядок. При кількох адаптерах задавайте
        # основний шлюз лише для потрібної мережі.
        gateway: "192.168.0.1"
    dns:
      # Список адрес DNS-серверів для cloud-init.
      servers:
        - "192.168.0.1"
      # Пошуковий домен DNS; це не окреме поле FQDN або hostname.
      domain: example.org
    # Обліковий запис, який налаштовується через cloud-init.
    user:
      name: homelab
      # Повні рядки публічних SSH-ключів, а не імена чи шляхи до файлів.
      # Замініть заглушку власним публічним ключем перед створенням ВМ.
      ssh_keys:
        - "REPLACE_WITH_YOUR_PUBLIC_SSH_KEY"

multiples:
  # Ключ групи використовується для організації YAML, а не як ім'я ВМ.
  workers:
    count:
      # Кількість ВМ у групі. При 0 група не створює ВМ.
      vmcount: 3
      # Перший номер в іменах; не впливає на початкові VMID та IP.
      startfrom: 1
    naming:
      # Ці значення дають worker-01, worker-02, worker-03.
      # Згенеровані імена також стають ключами ресурсів Terraform/OpenTofu.
      name_base: worker
      # Поки не обробляється модулем: номер завжди додається після основи.
      nameform: suffix
      # Роздільник. Якщо ключ пропущено, використовується "-".
      # Порожній рядок прибирає роздільник; null не використовуйте.
      delimiter: "-"
      # Мінімальна кількість цифр номера з доповненням нулями зліва.
      digits: 2
    # Спільні параметри обладнання всіх ВМ цієї групи.
    vm:
      # VMID = vmid_start + i, де i починається з 0: 2200, 2201, 2202.
      vmid_start: 2200
      # midi.c2m8 задає 2 CPU та 8192 MiB RAM.
      instance_type: midi.c2m8
      # Системний диск кожної ВМ (scsi0), не менше size_minimum із каталогу типів.
      disk_size: 40
      # Кожна ВМ отримає додатковий диск scsi1 на 100 GiB.
      # Для відмови від додаткових дисків задайте additional_disks: [].
      additional_disks:
        - size: 100
      pool: infrastructure
      # Ключі адаптерів мають збігатися з ключами networks нижче.
      interfaces:
        net0: vmbr0
      tags:
        - debian
        - debian-trixie
        - worker
    # Спільна схема мережі; адреси обчислюються окремо для кожної ВМ.
    networks:
      net0:
        # Адреса мережі та префікс CIDR.
        subnet: "192.168.0.0/24"
        # Зміщення першого хоста від адреси мережі, не останній октет.
        # IP = cidrhost(subnet, ip_start + i), i = 0, 1, 2, ...
        # У цьому прикладі: 192.168.0.120/24 ... 192.168.0.122/24.
        # Діапазон має вміщатися в підмережу та не перетинатися з іншими
        # вузлами, шлюзом, адресою мережі, broadcast і динамічним пулом DHCP.
        ip_start: 120
        # Спільний шлюз; без шлюзу ключ можна пропустити або задати null.
        gateway: "192.168.0.1"
    dns:
      servers:
        - "192.168.0.1"
      domain: example.org
    # Однаковий користувач і набір публічних ключів на всіх ВМ групи.
    user:
      name: homelab
      ssh_keys:
        - "REPLACE_WITH_YOUR_PUBLIC_SSH_KEY"

# Образи завантажуються у proxmox_ve_imagestorage з proxmox_ve.yaml.
# name — унікальний ключ, який має точно збігатися з default.import_disk
# відповідної родини в instance_types.yaml. Це не шлях до локального файлу.
import_disks:
  - name: "debian-13-genericcloud-amd64.qcow2"
    # URL хмарного образу з підтримкою cloud-init.
    # latest відстежує актуальну збірку; для фіксованої версії задайте її URL.
    import_url: "https://cdimage.debian.org/cdimage/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2"
